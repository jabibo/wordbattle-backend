# Production Environment Variables (Self-Hosted)
# Configuration for wordbattle-backend production service
# DO NOT commit this file to git - it's added to .gitignore

# Environment
ENVIRONMENT=production
ADMIN_EMAIL=jan@binge.de
ADMIN_USERNAME=admin

# Database Configuration (Self-Hosted Production Database)
DB_HOST=wordbattle-db
DB_PORT=5432
DB_NAME=wordbattle_prod
DB_USER=wordbattle_user
# DB_PASSWORD should be set via environment variable or secret management

# Cloud Provider Configuration
CLOUD_PROVIDER=self-hosted

# SMTP Configuration for Email Service
SMTP_USERNAME=service@binge-wordbattle.de
# SMTP_PASSWORD is configured as secret reference in Cloud Run service
FROM_EMAIL=service@binge-wordbattle.de
SMTP_SERVER=smtp.strato.de
SMTP_PORT=465
SMTP_USE_SSL=true

# Security Configuration (MUST be strong for production)
SECRET_KEY=89bb77194570d183259a98d0393b14fd9031c68a9d6526dac8d32122bee3d0f5

# Production-specific settings
ENABLE_CONTRACT_VALIDATION=true
CONTRACT_VALIDATION_STRICT=false

# Frontend Configuration (production should be restrictive)
FRONTEND_URL=https://wordbattle.binge-dev.de
CORS_ORIGINS=https://wordbattle.binge-dev.de

# Rate limiting (reasonable for production usage)
RATE_LIMIT=200

# Admin Configuration
ADMIN_EMAIL=jan@binge.de 

# Firebase Configuration (Self-Hosted Push Notifications)
FIREBASE_CREDENTIALS_PATH=/opt/wordbattle/config/firebase-credentials.json
ENABLE_PUSH_NOTIFICATIONS=true
