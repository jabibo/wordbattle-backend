# Test Environment Configuration
# Copy this to test.env and configure for local testing
# Usage: export $(cat test.env | xargs) before running tests

# Environment
TESTING=1
ENVIRONMENT=test

# Database Configuration (Docker Test Database)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=wordbattle_test
DB_USER=wordbattle_test
DB_PASSWORD=test_password_123

# Cloud Provider (use gcp for compatibility with existing code)
CLOUD_PROVIDER=gcp
GOOGLE_CLOUD_PROJECT=wordbattle-secure
CLOUD_REGION=europe-west1
USE_CLOUD_SQL=false

# Security (Test keys - NOT for production!)
SECRET_KEY=test-secret-key-change-in-production-this-is-only-for-testing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email (Disabled for testing)
SMTP_ENABLED=false
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Contracts (Disabled for testing)
CONTRACTS_VALIDATION_ENABLED=false
CONTRACTS_STRICT_MODE=false

# Logging
LOG_LEVEL=INFO

