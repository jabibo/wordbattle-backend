# Development Environment - Copy to .env for local Docker dev
# cp .env.dev.example .env

# Database (defaults work with docker-compose.dev.yml)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wordbattle

# Security (use weak key for dev only)
SECRET_KEY=dev-secret-key-change-in-production

# Push Notifications - set true when you have firebase-credentials.json in config/
ENABLE_PUSH_NOTIFICATIONS=false

# Optional: SMTP for email verification (can leave unset for dev)
# SMTP_SERVER=smtp.strato.de
# SMTP_PORT=465
# SMTP_USERNAME=your@email.de
# SMTP_PASSWORD=your-password
# FROM_EMAIL=your@email.de
# SMTP_USE_SSL=true
